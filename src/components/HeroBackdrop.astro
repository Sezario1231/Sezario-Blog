---
---

<div class="hero-backdrop absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
  <div class="nebula nebula-a"></div>
  <div class="nebula nebula-b"></div>
  <div class="nebula nebula-c"></div>
  <div class="nebula-veil"></div>
  <div class="nebula-stars"></div>
  <canvas class="nebula-canvas absolute inset-0 w-full h-full"></canvas>
</div>

<style>
  .hero-backdrop {
    z-index: 0;
  }

  .nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    mix-blend-mode: screen;
    animation: nebula-drift 24s ease-in-out infinite alternate;
    will-change: transform;
  }
  :global(.dark) .nebula {
    opacity: 0.5;
  }
  :global(:root:not(.dark)) .nebula {
    mix-blend-mode: multiply;
    opacity: 0.35;
  }

  .nebula-a {
    width: 70vw; height: 70vh;
    background: radial-gradient(circle at 30% 30%, hsl(28 90% 60% / 0.55), transparent 60%);
    top: -20%; left: -10%;
    animation-duration: 20s;
  }
  .nebula-b {
    width: 65vw; height: 65vh;
    background: radial-gradient(circle at 60% 40%, hsl(285 80% 65% / 0.5), transparent 60%);
    right: -15%; top: 5%;
    animation-duration: 28s;
    animation-delay: -8s;
  }
  .nebula-c {
    width: 55vw; height: 55vh;
    background: radial-gradient(circle at 50% 50%, hsl(190 85% 60% / 0.5), transparent 60%);
    bottom: -15%; left: 25%;
    animation-duration: 35s;
    animation-delay: -15s;
  }

  @keyframes nebula-drift {
    0% { transform: translate(0, 0) scale(1) rotate(0deg); }
    50% { transform: translate(6vw, -4vh) scale(1.15) rotate(20deg); }
    100% { transform: translate(-5vw, 6vh) scale(1.05) rotate(-15deg); }
  }

  /* 缓慢变色的流动光幕 */
  .nebula-veil {
    position: absolute;
    inset: -20%;
    background: conic-gradient(
      from 0deg at 50% 50%,
      hsl(215 70% 50% / 0.14),
      hsl(285 70% 55% / 0.14),
      hsl(330 70% 55% / 0.12),
      hsl(28 85% 55% / 0.14),
      hsl(160 70% 50% / 0.12),
      hsl(215 70% 50% / 0.14)
    );
    filter: blur(90px);
    animation: nebula-hue 40s linear infinite;
  }
  :global(.dark) .nebula-veil {
    mix-blend-mode: screen;
    opacity: 0.8;
  }
  :global(:root:not(.dark)) .nebula-veil {
    filter: blur(90px) saturate(1.3);
    opacity: 0.7;
  }

  @keyframes nebula-hue {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.2); }
    100% { transform: rotate(360deg) scale(1); }
  }

  /* 夜间星光 */
  .nebula-stars {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: nebula-twinkle 4s ease-in-out infinite alternate;
  }
  :global(.dark) .nebula-stars {
    opacity: 1;
    background-image:
      radial-gradient(1px 1px at 12% 22%, rgba(255,255,255,0.7), transparent 100%),
      radial-gradient(1px 1px at 30% 48%, rgba(255,255,255,0.45), transparent 100%),
      radial-gradient(1.5px 1.5px at 45% 18%, rgba(255,255,255,0.55), transparent 100%),
      radial-gradient(1px 1px at 62% 35%, rgba(255,255,255,0.4), transparent 100%),
      radial-gradient(1px 1px at 78% 58%, rgba(255,255,255,0.6), transparent 100%),
      radial-gradient(1.5px 1.5px at 90% 25%, rgba(255,255,255,0.45), transparent 100%),
      radial-gradient(1px 1px at 18% 75%, rgba(255,255,255,0.4), transparent 100%),
      radial-gradient(1px 1px at 55% 80%, rgba(255,255,255,0.5), transparent 100%),
      radial-gradient(1px 1px at 85% 70%, rgba(255,255,255,0.45), transparent 100%),
      radial-gradient(1.5px 1.5px at 70% 90%, rgba(255,255,255,0.35), transparent 100%);
  }

  @keyframes nebula-twinkle {
    0% { opacity: 0.5; }
    100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nebula, .nebula-veil, .nebula-stars {
      animation: none !important;
    }
  }
</style>

<script>
  function initCosmicCanvas() {
    const canvas = document.querySelector<HTMLCanvasElement>(".nebula-canvas");
    if (!canvas || canvas!.dataset.inited === "1") return;
    canvas!.dataset.inited = "1";

    const ctx = canvas!.getContext("2d");
    if (!ctx) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isMobile = window.innerWidth < 768;
    const LINK = 110;
    const COUNT = isMobile ? 22 : 36;

    let w = 0, h = 0, aid = 0;
    const mouse = { x: -9999, y: -9999 };

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    interface P { x: number; y: number; vx: number; vy: number; r: number; }
    const pts: P[] = [];
    for (let i = 0; i < COUNT; i++) {
      pts.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        r: Math.random() * 1.2 + 0.5,
      });
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);

      for (const p of pts) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) { p.x = 0; p.vx *= -1; }
        if (p.x > w) { p.x = w; p.vx *= -1; }
        if (p.y < 0) { p.y = 0; p.vy *= -1; }
        if (p.y > h) { p.y = h; p.vy *= -1; }
      }

      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const dx = pts[i].x - pts[j].x;
          const dy = pts[i].y - pts[j].y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < LINK) {
            ctx!.strokeStyle = `rgba(251, 146, 60, ${(1 - d / LINK) * 0.16})`;
            ctx!.beginPath();
            ctx!.moveTo(pts[i].x, pts[i].y);
            ctx!.lineTo(pts[j].x, pts[j].y);
            ctx!.stroke();
          }
        }
      }

      for (const p of pts) {
        const dm = Math.hypot(mouse.x - p.x, mouse.y - p.y);
        const near = dm < 150;
        const glow = near ? 9 : 4;
        const g = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, glow);
        g.addColorStop(0, near ? "rgba(255,180,90,0.9)" : "rgba(251,146,60,0.7)");
        g.addColorStop(1, "rgba(251,146,60,0)");
        ctx!.fillStyle = g;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, glow, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.fillStyle = `rgba(255,200,140,${near ? 0.9 : 0.5})`;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    function loop() {
      draw();
      aid = requestAnimationFrame(loop);
    }
    if (reduced) {
      draw();
    } else {
      loop();
    }

    const handleMove = (e: MouseEvent) => {
      const rect = canvas!.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    };
    const handleLeave = () => {
      mouse.x = -9999;
      mouse.y = -9999;
    };
    const handleVisibility = () => {
      if (document.hidden) {
        cancelAnimationFrame(aid);
      } else if (!reduced) {
        loop();
      }
    };

    window.addEventListener("resize", resize);
    window.addEventListener("mousemove", handleMove, { passive: true });
    document.addEventListener("mouseleave", handleLeave);
    document.addEventListener("visibilitychange", handleVisibility);
  }

  document.addEventListener("DOMContentLoaded", initCosmicCanvas);
  document.addEventListener("astro:page-load", initCosmicCanvas);
  initCosmicCanvas();
</script>